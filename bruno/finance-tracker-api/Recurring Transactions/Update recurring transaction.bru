meta {
  name: Update recurring transaction
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/recurring-transactions/{{recurringTransactionId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "type": "EXPENSE",
    "amount": 30.00,
    "categoryId": {{categoryId}},
    "description": "Updated recurring lunch",
    "frequency": "WEEKLY",
    "startDate": "{{fromDate}}",
    "active": true
  }
}
