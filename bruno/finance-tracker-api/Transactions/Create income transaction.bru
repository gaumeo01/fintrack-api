meta {
  name: Create income transaction
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "type": "INCOME",
    "amount": 5000000.00,
    "categoryId": {{categoryId}},
    "description": "Monthly salary",
    "transactionDate": "{{fromDate}}"
  }
}
