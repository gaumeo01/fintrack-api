meta {
  name: Create expense transaction
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "type": "EXPENSE",
    "amount": 240000.00,
    "categoryId": {{categoryId}},
    "description": "Groceries and lunch",
    "transactionDate": "2026-06-15"
  }
}
